<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PBR Duplas" Width="1160" Height="760" MinWidth="1020" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#0C1018" Foreground="#F3F5F8" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E8EEF7"/><Setter Property="Background" Value="#1B2533"/><Setter Property="BorderBrush" Value="#344257"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111A27"/><Setter Property="Foreground" Value="#EEF3FA"/><Setter Property="BorderBrush" Value="#344257"/><Setter Property="Padding" Value="10,9"/><Setter Property="CaretBrush" Value="#5EE4CA"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#9AAAC0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,5"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111722" BorderBrush="#222C3B" BorderThickness="0,0,1,0"><Grid Margin="22,29"><Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="PBR" FontSize="34" FontWeight="Black" Foreground="#61E5CA"/><TextBlock Text="D U P L A S" FontSize="12" FontWeight="SemiBold" Foreground="#BECBDD" Margin="2,2,0,0"/></StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="SUA BIBLIOTECA" Foreground="#677A94" FontSize="10" FontWeight="Bold" Margin="12,0,0,16"/><Button x:Name="HomeNav" Style="{StaticResource Nav}" Content="Jogo"/><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="Configurações"/><Button x:Name="NewsNav" Style="{StaticResource Nav}" Content="Novidades"/><Button x:Name="LogsNav" Style="{StaticResource Nav}" Content="Diagnóstico"/></StackPanel>
   <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="DOLPHIN · WINDOWS" FontSize="10" Foreground="#8193AB"/><TextBlock x:Name="LauncherVersion" Text="Launcher 1.0.0" FontSize="11" Foreground="#566A83" Margin="0,9,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="32,27,32,22"><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
   <Grid><TextBlock x:Name="PageTitle" Text="Visão geral" FontSize="19" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#172C2B" CornerRadius="11" Padding="11,5"><TextBlock x:Name="Connection" Text="Verificando atualizações" Foreground="#7DD8C6" FontSize="11"/></Border></Grid>
   <Grid x:Name="HomePage" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="260"/><RowDefinition Height="22"/><RowDefinition Height="94"/><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border CornerRadius="13" ClipToBounds="True" BorderBrush="#344858" BorderThickness="1"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#123C46" Offset="0"/><GradientStop Color="#1B253A" Offset="0.6"/><GradientStop Color="#352A37" Offset="1"/></LinearGradientBrush></Grid.Background>
     <Canvas HorizontalAlignment="Right" Width="330" Opacity="0.47" IsHitTestVisible="False"><Ellipse Width="330" Height="330" Stroke="#78EBD4" StrokeThickness="1" Canvas.Top="-35" Canvas.Left="45"/><Ellipse Width="240" Height="240" Stroke="#53BCBC" StrokeThickness="34" Canvas.Top="10" Canvas.Left="90"/><Ellipse Width="190" Height="190" Stroke="#D2FFF4" StrokeThickness="1" Canvas.Top="35" Canvas.Left="115"/><Line X1="0" Y1="130" X2="400" Y2="130" Stroke="#93D8CF" StrokeThickness="1"/><Ellipse Width="66" Height="66" Fill="#183C46" Stroke="#B1FFE5" StrokeThickness="6" Canvas.Left="177" Canvas.Top="97"/><Ellipse Width="16" Height="16" Fill="#E3FFF3" Canvas.Left="202" Canvas.Top="122"/></Canvas>
     <StackPanel Margin="29,26" Width="510" HorizontalAlignment="Left"><TextBlock Text="POKÉMON" FontSize="11" FontWeight="Bold" Foreground="#83DED0"/><TextBlock Text="BATTLE&#x0a;REVOLUTION" FontSize="36" FontWeight="Black" LineHeight="39" LineStackingStrategy="BlockLineHeight" Margin="-2,7,0,0"/><TextBlock Text="Seu time. Sua arena. A próxima batalha." Foreground="#C2D7DE" FontSize="14" Margin="0,13,0,0"/><Border Background="#28434A" HorizontalAlignment="Left" CornerRadius="4" Padding="9,5" Margin="0,18,0,0"><TextBlock Text="PBR DUPLAS  /  EDIÇÃO MODIFICADA" FontSize="10" Foreground="#AFD8D6"/></Border></StackPanel>
    </Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#151D2A" CornerRadius="9" Padding="15"><StackPanel><TextBlock Text="VERSÃO INSTALADA" FontSize="10" Foreground="#7F92AC"/><TextBlock x:Name="InstalledVersion" Text="Não preparado" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Background="#151D2A" CornerRadius="9" Padding="15"><StackPanel><TextBlock Text="DISPONÍVEL NO GITHUB" FontSize="10" Foreground="#7F92AC"/><TextBlock x:Name="AvailableVersion" Text="Consultando…" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Grid.Column="4" Background="#151D2A" CornerRadius="9" Padding="15"><StackPanel><TextBlock Text="INSTALAÇÃO" FontSize="10" Foreground="#7F92AC"/><TextBlock x:Name="InstallStatus" Text="Conferindo arquivos" FontSize="13" Foreground="#6CDEBF" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
    </Grid>
    <Border Grid.Row="4" Background="#151D2A" CornerRadius="10" Padding="20,17"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="Status" Text="Preparando seu launcher…" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="Detail" Grid.Row="1" Style="{StaticResource Muted}" Text="Suas configurações e o jogo instalado serão reconhecidos automaticamente." Margin="0,7,0,8"/>
     <StackPanel Grid.Row="2" VerticalAlignment="Center"><ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Foreground="#59DCC0" Background="#273547" BorderThickness="0"/><Expander Header="Detalhes da operação" Foreground="#8EA2BC" FontSize="11" Margin="0,8,0,4"><TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"/></Expander></StackPanel>
     <Grid Grid.Row="3" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Play" Content="INICIAR JOGO" Background="#60E1C2" Foreground="#082D29" BorderBrush="#60E1C2" FontWeight="Bold" Padding="27,13" IsEnabled="False"/><Button x:Name="Update" Grid.Column="1" Content="Atualizar" Margin="12,0,0,0"/><Button x:Name="Check" Grid.Column="2" Content="Verificar" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#9DAFC5"/></Grid>
    </Grid></Border>
   </Grid>
   <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Tudo no seu lugar" FontSize="25" FontWeight="Bold"/><TextBlock Style="{StaticResource Muted}" Text="Os caminhos da instalação anterior são importados automaticamente. Os modelos já instalados ficam na biblioteca local." Margin="0,9,0,20"/><StackPanel x:Name="PathFields"/><Button x:Name="SaveSettings" Content="Salvar configurações" HorizontalAlignment="Left" Margin="0,18,0,10" Background="#60E1C2" Foreground="#082D29"/><TextBlock Style="{StaticResource Muted}" Text="Os arquivos originais e os saves do Dolphin são preservados pelo instalador." Margin="0,10,0,15"/></StackPanel></ScrollViewer>
   <TextBlock Grid.Row="2" Text="PBR Duplas  ·  Atualizações pelo GitHub" Foreground="#526780" FontSize="10" VerticalAlignment="Bottom"/>
  </Grid>
 </Grid>
</Window>
