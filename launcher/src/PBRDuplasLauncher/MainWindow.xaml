<Window x:Class="PBRDuplasLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBR Duplas" Height="700" Width="1000"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="icon.png"
        Style="{StaticResource Bloodborne.Window}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0D0707"
            BorderBrush="{StaticResource Bloodborne.BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,32,24,0">
          <TextBlock Text="PBR" FontFamily="{StaticResource Bloodborne.Font.Title}"
                     FontSize="44" Foreground="{StaticResource Bloodborne.GoldBrush}"/>
          <TextBlock Text="DUPLAS" FontFamily="{StaticResource Bloodborne.Font.Title}"
                     FontSize="20" Foreground="{StaticResource Bloodborne.GoldDarkBrush}" Margin="0,-6,0,0"/>
          <Rectangle Height="1" Fill="{StaticResource Bloodborne.BorderBrush}" Margin="0,20,0,20"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="12,0">
          <Button Content="INÍCIO" Style="{StaticResource Bloodborne.Button}"
                  HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="NavHome_Click"/>
          <Button Content="ATUALIZAÇÕES" Style="{StaticResource Bloodborne.Button}"
                  HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="NavUpdates_Click"/>
          <Button Content="NOTAS DE VERSÃO" Style="{StaticResource Bloodborne.Button}"
                  HorizontalContentAlignment="Left" Margin="0,0,0,4" Click="NavNotes_Click"/>
          <Button Content="CONFIGURAÇÕES" Style="{StaticResource Bloodborne.Button}"
                  HorizontalContentAlignment="Left" Click="NavSettings_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,24">
          <Rectangle Height="1" Fill="{StaticResource Bloodborne.BorderBrush}" Margin="0,0,0,12"/>
          <TextBlock x:Name="VersionText" Text="Versão —" FontSize="12"
                     Foreground="{StaticResource Bloodborne.TextDimBrush}"/>
          <TextBlock x:Name="GameVersionText" Text="Jogo —" FontSize="12" Margin="0,4,0,0"
                     Foreground="{StaticResource Bloodborne.TextDimBrush}"/>
        </StackPanel>

        <Grid/>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <!-- INÍCIO -->
      <Grid x:Name="PageHome">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
          <TextBlock Text="POKÉMON BATTLE REVOLUTION" TextAlignment="Center" FontSize="14"
                     FontFamily="{StaticResource Bloodborne.Font.Title}"
                     Foreground="{StaticResource Bloodborne.TextDimBrush}"/>
          <TextBlock Text="A CAÇADA EM DUPLAS" TextAlignment="Center" Margin="0,8,0,0"
                     Style="{StaticResource Bloodborne.TitleText}"/>
          <Rectangle Height="1" Width="320" Fill="{StaticResource Bloodborne.GoldDarkBrush}" Margin="0,18,0,18"/>
          <TextBlock Text="Prepare-se. A batalha aguarda." TextAlignment="Center"
                     Foreground="{StaticResource Bloodborne.TextDimBrush}"/>
          <Button Content="INICIAR CAÇADA" Style="{StaticResource Bloodborne.Button.Primary}"
                  Width="300" Margin="0,40,0,0" Click="LaunchButton_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="LaunchHintText" TextAlignment="Center" FontSize="12"
                   Foreground="{StaticResource Bloodborne.TextDimBrush}" Margin="40,0,40,8"/>

        <Border Grid.Row="2" Background="#0D0707"
                BorderBrush="{StaticResource Bloodborne.BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="REGISTRO" FontSize="12" Margin="0,0,0,8"
                       FontFamily="{StaticResource Bloodborne.Font.Title}"
                       Foreground="{StaticResource Bloodborne.GoldDarkBrush}"/>
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                         Foreground="{StaticResource Bloodborne.TextDimBrush}"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ATUALIZAÇÕES -->
      <Grid x:Name="PageUpdates" Visibility="Collapsed" Margin="32">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ATUALIZAÇÕES" Style="{StaticResource Bloodborne.TitleText}"/>
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="0,8,0,0"
                   Fill="{StaticResource Bloodborne.BorderBrush}"/>

        <Button Grid.Row="1" Content="VERIFICAR NOVAMENTE" Style="{StaticResource Bloodborne.Button}"
                HorizontalAlignment="Left" Margin="0,20,0,16" Click="CheckUpdatesButton_Click"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="UpdateStatusText" Text="Verificando..." Margin="0,0,0,12"
                       Style="{StaticResource Bloodborne.SubtitleText}"/>
            <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Margin="0,0,0,12"
                         Style="{StaticResource Bloodborne.ProgressBar}"/>
            <TextBlock x:Name="UpdateDetailsText" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="3" x:Name="DownloadUpdateButton" Content="BAIXAR E APLICAR"
                Style="{StaticResource Bloodborne.Button.Primary}" HorizontalAlignment="Left"
                Margin="0,16,0,0" Visibility="Collapsed" Click="DownloadUpdateButton_Click"/>
      </Grid>

      <!-- NOTAS DE VERSÃO -->
      <Grid x:Name="PageNotes" Visibility="Collapsed" Margin="32">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="NOTAS DE VERSÃO" Style="{StaticResource Bloodborne.TitleText}"/>
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="0,8,0,0"
                   Fill="{StaticResource Bloodborne.BorderBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
          <ItemsControl x:Name="NotesList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Bloodborne.SurfaceBrush}"
                        BorderBrush="{StaticResource Bloodborne.BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,20">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Bloodborne.Font.Title}"
                                 FontSize="18" Foreground="{StaticResource Bloodborne.GoldBrush}"/>
                      <Border Background="{StaticResource Bloodborne.AccentBrush}" CornerRadius="2"
                              Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding BadgeVisibility}">
                        <TextBlock Text="PRÉVIA" FontSize="10"
                                   Foreground="{StaticResource Bloodborne.TextBrush}"/>
                      </Border>
                      <TextBlock Text="{Binding Date}" FontSize="11" Margin="10,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource Bloodborne.TextDimBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,4,0,6"
                               Foreground="{StaticResource Bloodborne.TextBrush}"/>
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource Bloodborne.TextDimBrush}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- CONFIGURAÇÕES -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
          <TextBlock Text="CONFIGURAÇÕES" Style="{StaticResource Bloodborne.TitleText}"/>
          <Rectangle Height="1" Fill="{StaticResource Bloodborne.BorderBrush}" Margin="0,8,0,24"/>

          <GroupBox Header="JOGO" Style="{StaticResource Bloodborne.GroupBox}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Arquivo do jogo (.rvz / .iso)" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GamePathBox" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                         Background="#0D0707" Foreground="{StaticResource Bloodborne.TextBrush}"
                         BorderBrush="{StaticResource Bloodborne.BorderBrush}" Padding="8,0"/>
                <Button Grid.Column="1" Content="PROCURAR" Style="{StaticResource Bloodborne.Button}"
                        Margin="8,0,0,0" Click="BrowseGame_Click"/>
              </Grid>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="EMULADOR" Style="{StaticResource Bloodborne.GroupBox}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Executável do Dolphin (Dolphin.exe)" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DolphinPathBox" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                         Background="#0D0707" Foreground="{StaticResource Bloodborne.TextBrush}"
                         BorderBrush="{StaticResource Bloodborne.BorderBrush}" Padding="8,0"/>
                <Button Grid.Column="1" Content="PROCURAR" Style="{StaticResource Bloodborne.Button}"
                        Margin="8,0,0,0" Click="BrowseDolphin_Click"/>
                <Button Grid.Column="2" Content="AUTO" Style="{StaticResource Bloodborne.Button}"
                        Margin="8,0,0,0" Click="AutoDetectDolphin_Click"/>
              </Grid>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="ATUALIZAÇÕES AUTOMÁTICAS" Style="{StaticResource Bloodborne.GroupBox}"
                    Margin="0,0,0,16">
            <CheckBox x:Name="AutoUpdateCheck" Content="Verificar atualizações ao abrir"
                      Foreground="{StaticResource Bloodborne.TextBrush}" FontSize="14"
                      VerticalContentAlignment="Center"/>
          </GroupBox>

          <GroupBox Header="REPOSITÓRIO" Style="{StaticResource Bloodborne.GroupBox}" Margin="0,0,0,24">
            <StackPanel>
              <TextBlock Text="Origem das atualizações (GitHub)" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="github.com/" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{StaticResource Bloodborne.TextDimBrush}"/>
                <TextBox x:Name="RepoBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                         Background="#0D0707" Foreground="{StaticResource Bloodborne.TextBrush}"
                         BorderBrush="{StaticResource Bloodborne.BorderBrush}" Padding="8,0"/>
              </Grid>
            </StackPanel>
          </GroupBox>

          <Button Content="SALVAR" Style="{StaticResource Bloodborne.Button.Primary}"
                  HorizontalAlignment="Left" Click="SaveSettings_Click"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>