<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="Bloodborne.Background">#140A0A</Color>
  <Color x:Key="Bloodborne.Surface">#1E1210</Color>
  <Color x:Key="Bloodborne.Border">#4A2E1A</Color>
  <Color x:Key="Bloodborne.Gold">#C9A227</Color>
  <Color x:Key="Bloodborne.GoldLight">#E8C85F</Color>
  <Color x:Key="Bloodborne.GoldDark">#8B6B1E</Color>
  <Color x:Key="Bloodborne.Text">#D4C4B0</Color>
  <Color x:Key="Bloodborne.TextDim">#8A7A6A</Color>
  <Color x:Key="Bloodborne.Accent">#7A2E2E</Color>
  <Color x:Key="Bloodborne.Hover">#2A1A18</Color>

  <SolidColorBrush x:Key="Bloodborne.BackgroundBrush" Color="{StaticResource Bloodborne.Background}"/>
  <SolidColorBrush x:Key="Bloodborne.SurfaceBrush" Color="{StaticResource Bloodborne.Surface}"/>
  <SolidColorBrush x:Key="Bloodborne.BorderBrush" Color="{StaticResource Bloodborne.Border}"/>
  <SolidColorBrush x:Key="Bloodborne.GoldBrush" Color="{StaticResource Bloodborne.Gold}"/>
  <SolidColorBrush x:Key="Bloodborne.GoldLightBrush" Color="{StaticResource Bloodborne.GoldLight}"/>
  <SolidColorBrush x:Key="Bloodborne.GoldDarkBrush" Color="{StaticResource Bloodborne.GoldDark}"/>
  <SolidColorBrush x:Key="Bloodborne.TextBrush" Color="{StaticResource Bloodborne.Text}"/>
  <SolidColorBrush x:Key="Bloodborne.TextDimBrush" Color="{StaticResource Bloodborne.TextDim}"/>
  <SolidColorBrush x:Key="Bloodborne.AccentBrush" Color="{StaticResource Bloodborne.Accent}"/>
  <SolidColorBrush x:Key="Bloodborne.HoverBrush" Color="{StaticResource Bloodborne.Hover}"/>

  <FontFamily x:Key="Bloodborne.Font.Title">Cinzel, Trajan Pro, Georgia, Times New Roman</FontFamily>
  <FontFamily x:Key="Bloodborne.Font.Body">Georgia, Cambria, Times New Roman</FontFamily>

  <Style x:Key="Bloodborne.Window" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Bloodborne.BackgroundBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.TextBrush}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Bloodborne.TextBlock" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.TextBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource Bloodborne.Font.Body}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="Bloodborne.TitleText" TargetType="TextBlock" BasedOn="{StaticResource Bloodborne.TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Bloodborne.Font.Title}"/>
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.GoldBrush}"/>
  </Style>

  <Style x:Key="Bloodborne.SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource Bloodborne.TextBlock}">
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.TextDimBrush}"/>
    <Setter Property="FontSize" Value="20"/>
  </Style>

  <Style x:Key="Bloodborne.GroupBox" TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.GoldBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource Bloodborne.Font.Title}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="BorderBrush" Value="{StaticResource Bloodborne.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource Bloodborne.SurfaceBrush}"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>

  <Style x:Key="Bloodborne.ProgressBar" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.GoldBrush}"/>
    <Setter Property="Background" Value="{StaticResource Bloodborne.BorderBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Bloodborne.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="18"/>
  </Style>

</ResourceDictionary>