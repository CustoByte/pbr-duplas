<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Bloodborne.Button" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.GoldBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Bloodborne.GoldDarkBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="{StaticResource Bloodborne.Font.Title}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="20,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Bloodborne.HoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bloodborne.GoldBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Bloodborne.GoldLightBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource Bloodborne.AccentBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Bloodborne.Button.Primary" TargetType="Button" BasedOn="{StaticResource Bloodborne.Button}">
    <Setter Property="Background" Value="{StaticResource Bloodborne.GoldDarkBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.BackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Bloodborne.GoldBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Padding" Value="32,14"/>
  </Style>

  <Style x:Key="Bloodborne.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Bloodborne.Button}">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Bloodborne.TextDimBrush}"/>
    <Setter Property="Padding" Value="12,6"/>
  </Style>

</ResourceDictionary>