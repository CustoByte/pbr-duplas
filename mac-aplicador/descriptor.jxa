ObjC.import("Foundation");
function run(argv) {
    if (argv.length !== 4) throw new Error('Parametros incompletos do descritor.');
    var descriptor = {
        type: 'dolphin-game-mod-descriptor', version: 1,
        'base-file': argv[0], 'display-name': 'PBR Duplas — ' + argv[2], maker: 'CustoByte',
        riivolution: {patches: [{xml: argv[1], root: argv[1].replace(/\/[^/]*$/, ''),
            options: [{'section-name': 'PBR Duplas', 'option-id': 'pbr-duplas', choice: 1}]}]}
    };
    var data = $(JSON.stringify(descriptor, null, 2)).dataUsingEncoding($.NSUTF8StringEncoding);
    if (!data.writeToFileAtomically(argv[3], true)) throw new Error('Nao foi possivel gravar o descritor.');
    return 'ok';
}
